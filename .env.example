# Copy to .env and fill in. NEVER commit .env (it's git-ignored).
# Never paste these values into an AI chat.

# --- The mesh -------------------------------------------------------------
# The box's Tailscale IP (starts with 100.). Get it with: tailscale ip -4
# Every service binds here, never 0.0.0.0.
TAILSCALE_IP=100.x.y.z

# --- The gateway ----------------------------------------------------------
# The credential your tools present to LiteLLM. Make it long and random.
# e.g. generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-me-to-something-long-and-random

# --- Provider API keys ----------------------------------------------------
# Fill in only the ones you use. Get them here:
#   Anthropic: https://console.anthropic.com/
#   Groq:      https://console.groq.com/keys
#   OpenAI:    https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Agent tools ----------------------------------------------------------
# Fine-grained GitHub PAT for the GitHub MCP server (Step 3), if you use it.
GITHUB_PERSONAL_ACCESS_TOKEN=
